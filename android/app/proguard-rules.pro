-dontnote kotlinx.serialization.**
-keepclassmembers class kotlinx.serialization.json.** { *** Companion; }
-keepclasseswithmembers class kotlinx.serialization.json.** { kotlinx.serialization.KSerializer serializer(...); }
-keep,includedescriptorclasses class in.vishwaship.app.**$$serializer { *; }
-keepclassmembers class in.vishwaship.app.** { *** Companion; }
-keepclasseswithmembers class in.vishwaship.app.** { kotlinx.serialization.KSerializer serializer(...); }

