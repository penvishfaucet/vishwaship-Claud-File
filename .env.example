# --- Core ---
# Leave DATABASE_URL empty for local demo (embedded PGlite in ./.data). Staging/production: real Postgres.
DATABASE_URL=
APP_URL=http://localhost:3000
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=
REDIS_URL=

# --- Owner bootstrap (one time) ---
OWNER_EMAIL=
OWNER_NAME=

# --- Local demo only: let seeded demo staff skip MFA. Never set in staging/production. ---
ALLOW_DEMO_STAFF_WITHOUT_MFA=

# --- Private document storage (S3-compatible) ---
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Provider credentials (Shipmozo, Razorpay, WATI, Resend/SMTP, SMS) are entered in
# Admin > Integrations and stored encrypted with APP_ENCRYPTION_KEY. Do not put them here.
# Razorpay webhook secret and WATI webhook token are also set per account in Admin.
