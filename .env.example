# Vishwaship environment variables — copy to .env (server) or .env.local (this PC) and fill in.
# NEVER commit real values. Provider keys (Shipmozo, Razorpay, WATI, email, SMS, stores) are
# entered in Admin > Integrations / customer Integrations and stored encrypted — not here.

# --- Core ---
NODE_ENV=production
# Public base URL of the site (used in links, invites, tracking URLs)
APP_URL=https://staging.example.com
# PostgreSQL connection. Leave EMPTY only for local demo (uses embedded PGlite in ./.data)
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/vishwaship
# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep a secure backup: losing it makes stored provider credentials and KYC files unreadable.
APP_ENCRYPTION_KEY=
REDIS_URL=

# --- Background jobs ---
# external = run `npm run worker` as a separate process (servers). Empty = run inside the web app (local).
WORKER_MODE=external

# --- Owner bootstrap (one time: npm run owner:bootstrap) ---
OWNER_EMAIL=
OWNER_NAME=

# --- Private document storage (S3-compatible: Cloudflare R2, Backblaze B2, AWS S3) ---
# Required on hosts that replace the disk on deploy (Hostinger). R2: S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com, S3_REGION=auto
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Store integrations ---
SHOPIFY_API_VERSION=2025-10

# --- Misc ---
NEXT_TELEMETRY_DISABLED=1

# --- LOCAL DEMO ONLY (never set on staging/production) ---
# PGLITE_DIR=./.data/pglite
# ALLOW_DEMO_STAFF_WITHOUT_MFA=1
# ALLOW_DEMO_SEED=1
