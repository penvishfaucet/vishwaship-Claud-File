{
  "name": "vishwaship-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Vishwaship courier aggregator: public site, customer portal, admin portal, provider adapters.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev --turbopack -p 3000",
    "prebuild": "node scripts/embed-migrations.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.mts",
    "db:seed": "tsx scripts/seed.mts",
    "owner:bootstrap": "tsx scripts/bootstrap-owner.mts",
    "verify:whatsapp": "tsx --tsconfig tsconfig.json --require ./scripts/stub-server-only.cjs scripts/verify-whatsapp.ts",
    "verify:fod": "tsx --tsconfig tsconfig.json --require ./scripts/stub-server-only.cjs scripts/verify-fod.ts",
    "worker": "tsx --conditions=react-server --tsconfig tsconfig.json src/server/jobs/worker.ts",
    "prestart": "tsx scripts/release.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.6.0",
    "@electric-sql/pglite": "0.2.17",
    "@pdf-lib/upng": "1.0.1",
    "@types/node": "22.10.7",
    "@types/pg": "8.11.10",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "aws4fetch": "1.0.20",
    "drizzle-orm": "0.38.4",
    "exceljs": "^4.4.0",
    "lucide-react": "0.469.0",
    "next": "^15.5.7",
    "pdf-lib": "1.17.1",
    "pg": "8.13.1",
    "react": "^19.1.2",
    "react-dom": "^19.1.2",
    "server-only": "0.0.1",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "undici": "6.21.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "drizzle-kit": "0.30.2",
    "pdfjs-dist": "4.10.38",
    "vitest": "2.1.8"
  }
}
